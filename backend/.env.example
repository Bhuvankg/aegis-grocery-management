APP_NAME=AEGIS AI API
APP_ENV=development
API_V1_PREFIX=/api
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/aegis_ai
FRONTEND_ORIGIN=http://localhost:5173

# Security & JWT Token Authentication
JWT_SECRET_KEY=change-this-secret-key-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
